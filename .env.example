# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase Dashboard → Settings → API → service_role key (GİZLİ, heç vaxt
# brauzerə/NEXT_PUBLIC_ ilə ötürülməsin). Yalnız server tərəfdə, RLS-i keçən
# etibarlı əməliyyatlar üçün (məs. bank ödəniş callback-i VIP təsdiqi).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Auth → Email OTP expiry (seconds). Default UI hint: 3600 (1 hour).
NEXT_PUBLIC_OTP_EXPIRY_SECONDS=#

# Cloudflare Turnstile (CAPTCHA) — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Upstash Redis (auth rate limit) — https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Supabase Storage (S3 protokolu)
# Supabase Dashboard → Storage → S3 Access Keys
S3_ENDPOINT=https://YOUR_PROJECT.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_BUCKET=property-images
S3_PUBLIC_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public

# Gələcəkdə Cloudflare R2-yə keçid üçün yalnız bunları dəyişin:
# S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://images.myroomaz.com

# Xəritə (Faza 2)
# NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# SEO — Google Search Console mülkiyyət təsdiqi (Search Console → Settings → Ownership verification → HTML tag → yalnız content= dəyərini bura yazın)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Kapital Bank (Birbank) onlayn ödəniş şlüzü — VIP alışları
# Sənəd: https://pg.kapitalbank.az/docs
# Test mühiti (rəsmi sənəddəki açıq sandbox etimadnamələri):
KAPITAL_PG_BASE_URL=https://txpgtst.kapitalbank.az/api
KAPITAL_PG_USERNAME=TerminalSys/kapital
KAPITAL_PG_PASSWORD=kapital123
# Prod mühitinə keçəndə (bank sizə ayrıca istifadəçi adı/şifrə verəcək):
# KAPITAL_PG_BASE_URL=https://e-commerce.kapitalbank.az/api
# KAPITAL_PG_USERNAME=your-merchant-username
# KAPITAL_PG_PASSWORD=your-merchant-password
